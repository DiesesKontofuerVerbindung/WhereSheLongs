; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="奇妙夜"
config/description="奇妙夜 RPG Demo - PART 1 to PART 4"
config/version="0.4.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://autoload/game_state.gd"
SceneManager="*res://autoload/scene_manager.gd"
EventBus="*res://autoload/event_bus.gd"
CGManager="*res://autoload/cg_manager.gd"
EventSystem="*res://systems/event_system.gd"
BlinkSystem="*res://addons/blink_trigger_scene_switch/blink_system.gd"
ClosedEyeSystem="*res://addons/closed_eye_trigger_scene_switch/closed_eye_system.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("blink_trigger_scene_switch", "closed_eye_trigger_scene_switch")

