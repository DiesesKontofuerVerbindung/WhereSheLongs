{
  "id": "part2_waterfall",
  "lines": [
    {
      "speaker": "旁白",
      "text": "小凌跑了很久终于追上了阿麦，他们来到了瀑布顶端。"
    },
    {
      "speaker": "旁白",
      "text": "他们站在瀑布的顶端一起向下望，依旧看不到底。"
    },
    {
      "speaker": "阿麦",
      "text": "（动作：回头）：你怕吗？"
    },
    {
      "speaker": "小凌",
      "text": "怕什么。"
    },
    {
      "speaker": "阿麦",
      "text": "跳水。"
    },
    {
      "speaker": "小凌",
      "text": "……"
    },
    {
      "speaker": "阿麦",
      "text": "要不要试试看？"
    },
    {
      "speaker": "小凌",
      "text": "我不会游泳。"
    },
    {
      "speaker": "阿麦",
      "text": "没关系，我会接住你。你不相信我吗？"
    },
    {
      "speaker": "小凌",
      "text": "（心理：犹豫）"
    },
    {
      "speaker": "旁白",
      "text": "阿麦索性直接跳了下去。"
    }
  ]
}
