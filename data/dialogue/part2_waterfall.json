{
  "id": "part2_waterfall",
  "lines": [
    {"speaker": "旁白", "text": "小凌跑了很久终于追上了阿麦。", "cg": "waterfall"},
    {"speaker": "旁白", "text": "他们站在瀑布的顶端，往下，依旧看不到底。"},
    {"speaker": "旁白", "text": "阿麦回头，你怕吗？"},
    {"speaker": "小凌", "text": "怕什么。"},
    {"speaker": "阿麦", "text": "跳水。"},
    {"speaker": "旁白", "text": "小凌没说话。"},
    {"speaker": "阿麦", "text": "要不要试试看？"},
    {"speaker": "小凌", "text": "我不会游泳。"},
    {"speaker": "阿麦", "text": "我接着你。你不相信我吗？"},
    {"speaker": "旁白", "text": "小凌看着水。"},
    {"speaker": "旁白", "text": "阿麦直接跳下去了。", "cg": "dive", "action": "set_var", "key": "affection_amai", "value": 5, "op": "add"}
  ]
}
