{
  "id": "part4_mystery_girl",
  "lines": [
    {
      "speaker": "旁白",
      "text": "小凌猛地睁开眼。"
    },
    {
      "speaker": "旁白",
      "text": "眼前是一片模糊的天空。"
    },
    {
      "speaker": "旁白",
      "text": "耳边传来水声。"
    },
    {
      "speaker": "旁白",
      "text": "她想动，却发现浑身都湿透了。"
    },
    {
      "speaker": "旁白",
      "text": "一个女孩正蹲在她身边，神情焦急。"
    },
    {
      "speaker": "旁白",
      "text": "小凌撑起身体，剧烈地咳嗽起来。"
    },
    {
      "speaker": "小凌",
      "text": "有个人和我一起……"
    },
    {
      "speaker": "神秘女孩",
      "text": "你差点死了。"
    },
    {
      "speaker": "旁白",
      "text": "小凌回头。"
    },
    {
      "speaker": "旁白",
      "text": "湖面平静得像什么都没有发生过。"
    },
    {
      "speaker": "小凌",
      "text": "……他呢？"
    },
    {
      "speaker": "神秘女孩",
      "text": "谁？"
    },
    {
      "speaker": "小凌",
      "text": "就是刚才和我一起的人。"
    },
    {
      "speaker": "旁白",
      "text": "女孩皱了皱眉，指了指湖对面的森林。"
    },
    {
      "speaker": "旁白",
      "text": "女孩坐在小凌旁边，把自己的外套递给她。"
    },
    {
      "speaker": "神秘女孩",
      "text": "冷吗？"
    },
    {
      "speaker": "旁白",
      "text": "小凌摇头。"
    },
    {
      "speaker": "旁白",
      "text": "过了一会儿。"
    },
    {
      "speaker": "小凌",
      "text": "有一点。"
    },
    {
      "speaker": "旁白",
      "text": "女孩把外套披在她身上。"
    },
    {
      "speaker": "旁白",
      "text": "两个人并排坐在湖边。"
    },
    {
      "speaker": "旁白",
      "text": "谁也没有说话。"
    },
    {
      "speaker": "旁白",
      "text": "过了一会儿，小凌忽然开口。"
    },
    {
      "speaker": "小凌",
      "text": "你为什么跟着我？"
    },
    {
      "speaker": "神秘女孩",
      "text": "因为……有点担心。"
    },
    {
      "speaker": "小凌",
      "text": "就这样？"
    },
    {
      "speaker": "神秘女孩",
      "text": "不然呢？"
    },
    {
      "speaker": "旁白",
      "text": "小凌低头。"
    },
    {
      "speaker": "神秘女孩",
      "text": "你刚才为什么跳下去？"
    },
    {
      "speaker": "小凌",
      "text": "……"
    },
    {
      "speaker": "神秘女孩",
      "text": "是因为他让你跳？"
    },
    {
      "speaker": "旁白",
      "text": "小凌摇头。"
    },
    {
      "speaker": "神秘女孩",
      "text": "那是因为你自己想跳？"
    },
    {
      "speaker": "旁白",
      "text": "小凌还是没有回答。"
    },
    {
      "speaker": "旁白",
      "text": "很久以后，她才小声说："
    },
    {
      "speaker": "小凌",
      "text": "我不知道。"
    },
    {
      "speaker": "神秘女孩",
      "text": "不知道。"
    },
    {
      "speaker": "神秘女孩",
      "text": "不知道以后做什么。"
    },
    {
      "speaker": "神秘女孩",
      "text": "不知道喜不喜欢一个人。"
    },
    {
      "speaker": "神秘女孩",
      "text": "不知道要不要留下。"
    },
    {
      "speaker": "神秘女孩",
      "text": "不知道要不要往前走。"
    },
    {
      "speaker": "旁白",
      "text": "女孩看着她。"
    },
    {
      "speaker": "神秘女孩",
      "text": "不知道自己到底想要什么。"
    },
    {
      "speaker": "旁白",
      "text": "小凌没有说话。"
    },
    {
      "speaker": "旁白",
      "text": "她把膝盖抱在怀里。"
    },
    {
      "speaker": "小凌",
      "text": "你怎么知道？"
    },
    {
      "speaker": "神秘女孩",
      "text": "猜的。"
    },
    {
      "speaker": "小凌",
      "text": "猜得也太准了。"
    },
    {
      "speaker": "旁白",
      "text": "女孩笑了一下。"
    },
    {
      "speaker": "神秘女孩",
      "text": "因为我也这样。"
    },
    {
      "speaker": "旁白",
      "text": "小凌转过头。"
    },
    {
      "speaker": "旁白",
      "text": "女孩看着湖面。"
    },
    {
      "speaker": "神秘女孩",
      "text": "有一段时间，我特讨厌别人问我“以后想干什么”。"
    },
    {
      "speaker": "小凌",
      "text": "我也是。"
    },
    {
      "speaker": "神秘女孩",
      "text": "每次有人问，我都觉得自己应该马上回答。"
    },
    {
      "speaker": "旁白",
      "text": "小凌点头。"
    },
    {
      "speaker": "神秘女孩",
      "text": "好像别人都已经知道答案了。"
    },
    {
      "speaker": "小凌",
      "text": "对。"
    },
    {
      "speaker": "神秘女孩",
      "text": "有人想去大城市。"
    },
    {
      "speaker": "神秘女孩",
      "text": "有人想早点结婚。"
    },
    {
      "speaker": "神秘女孩",
      "text": "有人想早点生孩子。"
    },
    {
      "speaker": "神秘女孩",
      "text": "有人想赚很多钱。"
    },
    {
      "speaker": "旁白",
      "text": "女孩停了一下。"
    },
    {
      "speaker": "神秘女孩",
      "text": "只有自己，好像什么都不知道。"
    },
    {
      "speaker": "旁白",
      "text": "小凌看着她。"
    },
    {
      "speaker": "小凌",
      "text": "后来呢？"
    },
    {
      "speaker": "神秘女孩",
      "text": "后来我选了一个。"
    },
    {
      "speaker": "小凌",
      "text": "你想要的吗？"
    },
    {
      "speaker": "旁白",
      "text": "女孩沉默了一会儿。"
    },
    {
      "speaker": "神秘女孩",
      "text": "那时候的我，以为是。"
    },
    {
      "speaker": "小凌",
      "text": "那现在呢？"
    },
    {
      "speaker": "旁白",
      "text": "女孩没有回答。"
    },
    {
      "speaker": "旁白",
      "text": "她捡起脚边的一片叶子，在手里慢慢揉碎。"
    },
    {
      "speaker": "神秘女孩",
      "text": "现在的我觉得……"
    },
    {
      "speaker": "神秘女孩",
      "text": "可能没有哪一个选择，是从一开始就知道答案的。"
    },
    {
      "speaker": "小凌",
      "text": "那不是很可怕吗？"
    },
    {
      "speaker": "神秘女孩",
      "text": "是。"
    },
    {
      "speaker": "小凌",
      "text": "那你怎么敢选？"
    },
    {
      "speaker": "神秘女孩",
      "text": "不敢。"
    },
    {
      "speaker": "旁白",
      "text": "女孩笑了。"
    },
    {
      "speaker": "神秘女孩",
      "text": "所以我也有过很多晚上，躲在被子里偷偷哭。"
    },
    {
      "speaker": "小凌",
      "text": "你这么酷的女孩，也会这么干吗？"
    },
    {
      "speaker": "神秘女孩",
      "text": "我也羡慕过别人。"
    },
    {
      "speaker": "神秘女孩",
      "text": "也想过，如果当初走另一条路，会不会更好。"
    },
    {
      "speaker": "神秘女孩",
      "text": "也有过特别想逃走的时候。"
    },
    {
      "speaker": "旁白",
      "text": "小凌轻轻问：你逃了吗？"
    },
    {
      "speaker": "神秘女孩",
      "text": "有时候。"
    },
    {
      "speaker": "小凌",
      "text": "后来呢？"
    },
    {
      "speaker": "神秘女孩",
      "text": "后来又回来了。"
    },
    {
      "speaker": "小凌",
      "text": "为什么？"
    },
    {
      "speaker": "旁白",
      "text": "女孩看着她。"
    },
    {
      "speaker": "神秘女孩",
      "text": "因为有一些东西，我还是舍不得。"
    },
    {
      "speaker": "旁白",
      "text": "小凌没有再问。"
    },
    {
      "speaker": "旁白",
      "text": "她忽然想到了小仓。"
    },
    {
      "speaker": "旁白",
      "text": "那个总是很忙、总是把生活安排得井井有条的人。"
    },
    {
      "speaker": "旁白",
      "text": "他真的不好吗？"
    },
    {
      "speaker": "旁白",
      "text": "好像也没有。"
    },
    {
      "speaker": "旁白",
      "text": "可她为什么还是觉得难过？"
    },
    {
      "speaker": "旁白",
      "text": "女孩突然问：你喜欢他吗？（这是在刚入世界的时候，小凌就向她诉说了自己的烦恼）"
    },
    {
      "speaker": "旁白",
      "text": "小凌愣住。"
    },
    {
      "speaker": "小凌",
      "text": "……喜欢吧。"
    },
    {
      "speaker": "神秘女孩",
      "text": "那为什么还要逃？"
    },
    {
      "speaker": "旁白",
      "text": "小凌沉默了很久。"
    },
    {
      "speaker": "小凌",
      "text": "因为我怕。"
    },
    {
      "speaker": "神秘女孩",
      "text": "怕什么？"
    },
    {
      "speaker": "小凌",
      "text": "怕以后就只能这样了。"
    },
    {
      "speaker": "神秘女孩",
      "text": "哪样？"
    },
    {
      "speaker": "旁白",
      "text": "小凌低下头。"
    },
    {
      "speaker": "小凌",
      "text": "每天起床，做饭，工作，回家。"
    },
    {
      "speaker": "小凌",
      "text": "然后结婚。"
    },
    {
      "speaker": "小凌",
      "text": "然后可能有孩子。"
    },
    {
      "speaker": "小凌",
      "text": "然后……"
    },
    {
      "speaker": "旁白",
      "text": "她没有继续说。"
    },
    {
      "speaker": "旁白",
      "text": "女孩替她说完："
    },
    {
      "speaker": "神秘女孩",
      "text": "然后慢慢忘记自己是谁。"
    },
    {
      "speaker": "旁白",
      "text": "小凌眼眶突然红了。"
    },
    {
      "speaker": "旁白",
      "text": "她看着女孩。"
    },
    {
      "speaker": "小凌",
      "text": "……你也会这样想吗？"
    },
    {
      "speaker": "旁白",
      "text": "女孩没有回答，只是轻轻说：有时候。"
    },
    {
      "speaker": "旁白",
      "text": "两个人靠在一起。"
    },
    {
      "speaker": "旁白",
      "text": "只是两个恰好坐在湖边的陌生女人，可是这一刻，她们却有一种奇怪的默契。"
    },
    {
      "speaker": "旁白",
      "text": "小凌慢慢把头靠在女孩肩膀上。"
    },
    {
      "speaker": "旁白",
      "text": "女孩身体僵了一下。却没有躲开。"
    },
    {
      "speaker": "旁白",
      "text": "过了一会儿，她轻轻靠在小凌头上。"
    },
    {
      "speaker": "神秘女孩",
      "text": "其实我觉得……"
    },
    {
      "speaker": "小凌",
      "text": "嗯？"
    },
    {
      "speaker": "神秘女孩",
      "text": "如果有一天，你真的选择了结婚。"
    },
    {
      "speaker": "神秘女孩",
      "text": "也不要把自己弄丢了。"
    },
    {
      "speaker": "旁白",
      "text": "小凌沉默。"
    },
    {
      "speaker": "神秘女孩",
      "text": "如果有一天，你选择不结婚。"
    },
    {
      "speaker": "神秘女孩",
      "text": "也不要觉得自己做错了。"
    },
    {
      "speaker": "神秘女孩",
      "text": "如果有一天，你改变主意了。"
    },
    {
      "speaker": "神秘女孩",
      "text": "也没关系。"
    },
    {
      "speaker": "小凌",
      "text": "……"
    },
    {
      "speaker": "神秘女孩",
      "text": "人不是一条路走到底的。"
    },
    {
      "speaker": "旁白",
      "text": "小凌轻轻问："
    },
    {
      "speaker": "小凌",
      "text": "那你呢？"
    },
    {
      "speaker": "旁白",
      "text": "女孩看着湖面。"
    },
    {
      "speaker": "旁白",
      "text": "很久之后。"
    },
    {
      "speaker": "神秘女孩",
      "text": "我啊……"
    },
    {
      "speaker": "神秘女孩",
      "text": "我现在也还在找。"
    },
    {
      "speaker": "旁白",
      "text": "小凌抬起头。"
    },
    {
      "speaker": "旁白",
      "text": "女孩也转过来看她。"
    },
    {
      "speaker": "旁白",
      "text": "两个人对视。"
    },
    {
      "speaker": "旁白",
      "text": "那一瞬间，小凌突然觉得眼前这个女孩有一种说不出的熟悉感。"
    },
    {
      "speaker": "旁白",
      "text": "像是在哪里见过。"
    },
    {
      "speaker": "旁白",
      "text": "又像是从来没有见过。"
    },
    {
      "speaker": "旁白",
      "text": "女孩伸手，轻轻摸了摸她的头发。"
    },
    {
      "speaker": "旁白",
      "text": "动作很轻。"
    },
    {
      "speaker": "旁白",
      "text": "却又熟悉得让小凌鼻子一酸。"
    },
    {
      "speaker": "小凌",
      "text": "我们以前是不是见过？"
    },
    {
      "speaker": "旁白",
      "text": "女孩停了一下。"
    },
    {
      "speaker": "旁白",
      "text": "然后笑着说："
    },
    {
      "speaker": "神秘女孩",
      "text": "可能吧。"
    },
    {
      "speaker": "小凌",
      "text": "什么时候？"
    },
    {
      "speaker": "旁白",
      "text": "女孩没有回答。"
    },
    {
      "speaker": "旁白",
      "text": "不稳定的世界开始震动，世界慢慢缩小，小凌很着急地想知道对方是谁"
    },
    {
      "speaker": "旁白",
      "text": "小凌（很着急地）：什么时候？在哪儿见过？"
    },
    {
      "speaker": "旁白",
      "text": "女孩没有回答。"
    },
    {
      "speaker": "旁白",
      "text": "世界越来越摇晃和震动，东倒西歪，小凌和女孩被摇晃地站不住，小凌伸手要抓住女孩，"
    },
    {
      "speaker": "旁白",
      "text": "就要抓住的那一刻，"
    },
    {
      "speaker": "旁白",
      "text": "不稳定的世界关上了门……"
    }
  ]
}
