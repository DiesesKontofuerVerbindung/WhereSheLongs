{
  "id": "part2_stream",
  "lines": [
    {
      "speaker": "阿麦",
      "text": "（动作：向上看着刚才跳下来的瀑布顶端）：你看……"
    },
    {
      "speaker": "旁白",
      "text": "溪水在月光下闪着细碎的光。"
    },
    {
      "speaker": "阿麦",
      "text": "什么都没有发生。"
    },
    {
      "speaker": "小凌",
      "text": "……"
    },
    {
      "speaker": "阿麦",
      "text": "衣服湿了可以晒干。"
    },
    {
      "speaker": "小凌",
      "text": "你真是个怪人。"
    },
    {
      "speaker": "阿麦",
      "text": "（动作：低头看着水里的自己）：所以你对自己可以不用这么严格。"
    },
    {
      "speaker": "小凌",
      "text": "你说什么？"
    },
    {
      "speaker": "阿麦",
      "text": "（动作：抬起头看着小凌）：想做什么就做什么。"
    },
    {
      "speaker": "小凌",
      "text": "哪有那么简单。"
    },
    {
      "speaker": "阿麦",
      "text": "为什么不简单？"
    },
    {
      "speaker": "小凌",
      "text": "因为……"
    },
    {
      "action": "text_input",
      "prompt": "请输入：",
      "var_key": "custom_player_text",
      "placeholder": "为什么人不能想做什么就做什么？"
    },
    {
      "speaker": "小凌",
      "text": "{custom_player_text}"
    },
    {
      "speaker": "阿麦",
      "text": "（动作：拉起小凌的手）：那就只做你最想做的那件事"
    }
  ]
}
