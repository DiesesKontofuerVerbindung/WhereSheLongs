[
  {
    "speaker": "旁白",
    "text": "他们顺着小溪往前走，是一个巨大的神秘的湖，湖水深不见底，像深渊一样，什么都看不到。"
  },
  {
    "speaker": "旁白",
    "text": "湖中散落着一块块巨大的形状各异的黑色石头，湖对岸长着一片尖尖的红色植物，像火一样在黑暗中摇曳。"
  },
  {
    "speaker": "旁白",
    "text": "阿麦走到岸边。"
  },
  {
    "speaker": "小凌",
    "text": "你干什么？"
  },
  {
    "speaker": "旁白",
    "text": "阿麦没有回答。"
  },
  {
    "speaker": "旁白",
    "text": "他踩上一块石头。"
  },
  {
    "speaker": "旁白",
    "text": "再跳到下一块。"
  },
  {
    "speaker": "旁白",
    "text": "轻轻松松地到了湖面中央。"
  },
  {
    "speaker": "旁白",
    "text": "小凌站在岸边。"
  },
  {
    "speaker": "小凌",
    "text": "那里很滑。"
  },
  {
    "speaker": "旁白",
    "text": "阿麦回头。"
  },
  {
    "speaker": "阿麦",
    "text": "所以呢？"
  },
  {
    "speaker": "小凌",
    "text": "会摔下去。"
  },
  {
    "speaker": "旁白",
    "text": "阿麦笑了。"
  },
  {
    "speaker": "阿麦",
    "text": "那就摔下去。"
  },
  {
    "speaker": "旁白",
    "text": "小凌愣住。"
  },
  {
    "speaker": "旁白",
    "text": "阿麦站在水中央。"
  },
  {
    "speaker": "旁白",
    "text": "张开双臂。"
  },
  {
    "speaker": "阿麦",
    "text": "你不想试试吗？"
  },
  {
    "speaker": "小凌",
    "text": "不想。"
  },
  {
    "speaker": "阿麦",
    "text": "真的？"
  },
  {
    "speaker": "小凌",
    "text": "真的。"
  },
  {
    "speaker": "旁白",
    "text": "阿麦突然跳进水里。"
  },
  {
    "speaker": "旁白",
    "text": "“扑通。”"
  },
  {
    "speaker": "旁白",
    "text": "水花溅起来。"
  },
  {
    "speaker": "旁白",
    "text": "小凌下意识后退。"
  },
  {
    "speaker": "旁白",
    "text": "下一秒——"
  },
  {
    "speaker": "旁白",
    "text": "阿麦从水里冒出来。"
  },
  {
    "speaker": "旁白",
    "text": "头发湿漉漉地贴在脸上。"
  },
  {
    "speaker": "旁白",
    "text": "小凌怔怔地看着他。"
  }
]