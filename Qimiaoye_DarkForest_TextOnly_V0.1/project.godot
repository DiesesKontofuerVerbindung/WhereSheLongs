; 独立并行灰盒：黑暗森林纯文本版
config_version=5

[application]

config/name="奇妙夜·黑暗森林·并行玩法整合版"
config/description="纯文字剧情外壳与按 DOCX 固定行接入的独立玩法"
config/version="1.3.8"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="Qimiaoye_DarkForest_TextOnly_V0.1"

[autoload]

GameState="*res://autoload/game_state.gd"

[display]

window/dpi/allow_hidpi=true
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

